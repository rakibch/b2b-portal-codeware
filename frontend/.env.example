# Base URL of the Laravel API. Keep the default when the SPA is served from the same origin
# (recommended: reverse proxy /api to Laravel). Use a full URL only for a separate API host.
VITE_API_URL=/api/v1

# Dev server proxy target for /api
VITE_DEV_API_PROXY=http://127.0.0.1:8000

VITE_APP_NAME="B2B Wholesale Portal"

# Notification polling interval (seconds)
VITE_NOTIFICATION_POLL_SECONDS=60
