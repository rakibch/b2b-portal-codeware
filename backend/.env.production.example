# =============================================================================
# B2B Wholesale Portal — PRODUCTION environment template
# Copy to .env on the server, fill every CHANGE_ME, then: php artisan key:generate
# Never commit the real .env. Restrict permissions: chmod 640 .env (owner deploy, group www-data)
# =============================================================================

APP_NAME="B2B Wholesale Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://portal.example.com
FRONTEND_URL=https://portal.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database (MySQL 8 shown; for PostgreSQL use DB_CONNECTION=pgsql / port 5432) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=b2b_portal
DB_USERNAME=b2b_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Cache / rate limiting / queues: use Redis so limits are shared across PHP workers ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# --- Mail (notifications, invitations, password resets) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Files: KYC documents and payment slips MUST stay on a private disk ---
FILESYSTEM_DISK=local
KYC_DISK=local
PAYMENT_SLIP_DISK=local
KYC_MAX_FILE_KB=5120

# --- API security ---
CORS_ALLOWED_ORIGINS=https://portal.example.com
SANCTUM_TOKEN_EXPIRATION=10080
# Comma-separated proxy IPs/CIDRs in front of PHP (load balancer). Leave empty if none.
TRUSTED_PROXIES=

# --- Payments ---
PAYMENT_GATEWAY=mock
# The sandbox gateway must stay disabled in production until a real driver is configured.
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_SECRET=

# --- Business rules ---
INVITATION_EXPIRES_HOURS=72
RFQ_VALIDITY_DAYS=7
QUICK_ORDER_IMPORT_MAX_ROWS=500
QUICK_ORDER_IMPORT_MAX_KB=2048

# --- First deploy only: super admin seed (password >= 12 chars, change after first login) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEFAULT_PASSWORD=
